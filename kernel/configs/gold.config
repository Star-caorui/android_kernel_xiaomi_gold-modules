# Redmi Note 13 5G (gold), on top of mgk_64_k66_defconfig and mt6833_overlay.config

# Not on this board
# CONFIG_DEVICE_MODULES_STMMAC_ETH is not set
# CONFIG_MTK_CROSS_SCHEDULER is not set
# CONFIG_BATTERY_MT6357 is not set
# CONFIG_GAUGE_MT6375 is not set
# CONFIG_BATTERY_MT6358 is not set
# CONFIG_GAUGE_BQ28Z610 is not set

# Not on this board either, but stock builds the MT6379 gauge (and does not ship
# it): mtk_battery_manager takes force_get_tbat() from mt6379-battery, which
# modpost finds before the MT6359P's, and so depends on it

# Stock's aee_aed has no /proc/last_kmsg
# CONFIG_MTK_LAST_KMSG is not set

# The Redmi Pad SE's touchscreens and panels, from mgk_64_k66_defconfig; gold's (FocalTech
# FT3683G, Goodix GT9916R) are built from vendor/huaqin/kernel_modules/gold
CONFIG_TOUCHSCREEN_MTK_TOUCH="GT9895 GT9886 GT9896S GT1151 NT36672C_I2C legacy_gt9896s"
# CONFIG_TOUCHSCREEN_NT36523D_HOSTDL_SPI is not set
# CONFIG_TOUCHSCREEN_ICNL9951R_SPI is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_35_02_0A_60_VDO is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_35_02_0A_90_VDO is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_35_02_0A_90_THINNING_VDO is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_46_0F_0C_60_VDO is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_46_0F_0C_90_VDO is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_46_0F_0C_90_THINNING_VDO is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_47_02_0B_60_VDO is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_47_02_0B_90_VDO is not set
# CONFIG_DRM_PANEL_DSI_PANEL_N85_47_02_0B_90_THINNING_VDO is not set

# gold's charging: MediaTek's charger framework on the MT6360, the MT6359P's
# gauge with the battery manager, the pump express and PD algorithms, the
# SC8551 or LN8000 charge pump and Huaqin's charger nodes, as stock has them
CONFIG_MTK_CHARGER=m
CONFIG_MTK_CHARGER_TYPE_DETECT=m
CONFIG_DEVICE_MODULES_CHARGER_MT6360=m
CONFIG_BATTERY_MT6359P=m
CONFIG_MTK_PUMP_EXPRESS_PLUS_SUPPORT=m
CONFIG_MTK_PUMP_EXPRESS_PLUS_20_SUPPORT=m
CONFIG_MTK_PUMP_EXPRESS_40_SUPPORT=m
CONFIG_MTK_PUMP_EXPRESS_50_SUPPORT=m
# CONFIG_MTK_PUMP_EXPRESS_45_SUPPORT is not set
# CONFIG_MTK_PUMP_EXPRESS_50_PLUS_SUPPORT is not set
CONFIG_SC8551X_CHARGER=m
CONFIG_LN8000_CHARGER=m
CONFIG_HQ_NOTIFY=m
CONFIG_HQ_CHARGER_SYSFS=m
# and Huaqin's charging fault reports to Xiaomi's event reporting (miev)
CONFIG_XM_CHG_DFS=m
# Not on this board
# CONFIG_MTK_HVBP_SUPPORT is not set
# CONFIG_CURRENT_SELECTOR_MTK_2P_CHARGER is not set
# CONFIG_CHARGER_RT9490 is not set
# CONFIG_CHARGER_RT9758 is not set
# CONFIG_CHARGER_RT9759 is not set
# CONFIG_CHARGER_MT6375 is not set
# CONFIG_CHARGER_MT6985_ALPHA_SUPPORT is not set
# CONFIG_GAUGE_MT6983_ALPHA_SUPPORT is not set

# Type-C: MediaTek's TCPC stack with the MT6360's port controller, as stock gold
# has (tcpc_class, tcpc_mt6360, rt_pd_manager), not the Redmi Pad SE's Southchip one
# CONFIG_SOUTHCHIP_TCPC_CLASS is not set
# CONFIG_TCPC_SY6976 is not set
# CONFIG_TCPC_SC660X is not set
# CONFIG_TCPC_RT1711H is not set
CONFIG_TCPC_CLASS=m
CONFIG_TCPC_MT6360=m
# The MT6379 and its UFCS port are not on this board. Merged one fragment at a time, as the
# make build did, they went out with the charger framework still off; merged at once, as
# Kleaf does, they stay unless turned off here.
# CONFIG_TCPC_MT6379 is not set
# CONFIG_UFCS_CLASS is not set
# CONFIG_UFCS_MT6379 is not set
# with water detection on the port, as stock has it
CONFIG_MTK_TYPEC_WATER_DETECT=m

# gold's trusted OS is Xiaomi's mitee beside MediaTek's GenieZone. Stock builds
# no Trustonic or Microtrust client and no kernel TEE subsystem: trusted_mem,
# rpmb-mtk and the secure command queue talk to GenieZone only.
# CONFIG_TEE is not set
# CONFIG_TRUSTONIC_TEE_SUPPORT is not set
# CONFIG_MICROTRUST_TEE_SUPPORT is not set
# Stock still reserves the secure video region and sets up the IOMMU's secure
# side for the secure memory regions, which those clients would have enabled
CONFIG_MTK_SEC_VIDEO_PATH_SUPPORT=y
# and Xiaomi's mitee, the client of gold's own trusted OS (keymint, gatekeeper)
CONFIG_MITEE_SUPPORT=m
# and MediaTek's TEE perf driver, which raises CPU frequencies for the trusted OS's
# clients, as stock has it without the kernel's TEE subsystem
CONFIG_TEE_PERF_SUPPORT=m

# gold's fingerprint sensors: FPC 1022 or Goodix
CONFIG_MTK_FINGERPRINT_SUPPORT=m
CONFIG_FPC_FINGERPRINT=m
CONFIG_GOODIX_FINGERPRINT=m

# Xiaomi's binder priority boost for the launcher, system UI and SurfaceFlinger
CONFIG_BINDER_PRIO=m

# gold's cameras, as stock's imgsensor module has them, in place of the
# Redmi Pad SE's. Their power comes from the WL2866 camera LDO (smartldo).
CONFIG_CUSTOM_KERNEL_IMGSENSOR="s5khm6_semco_main_mipi_raw s5khm6_aac_main_mipi_raw ov64b40_ofilm_main_mipi_raw ov50d40_sunny_main_mipi_raw ov16a1q_aac_front_mipi_raw ov16a1q_sunny_front_mipi_raw ov08d10_aac_ultra_mipi_raw ov08d10_sunny_ultra_mipi_raw sc202cs_aac_depth_mipi_raw sc202pcs_aac_macro_mipi_raw sc202cs_sunny_depth_mipi_raw sc202cs_sunny2_depth_mipi_raw sc202pcs_sunny_macro_mipi_raw gc16b3_aac_front_mipi_raw gc16b3_sunny_front_mipi_raw"

# Keep the Google kernel itself exactly as gki_defconfig builds it: these are
# changed by mgk_64_k66_defconfig and would change the KMI's symbol CRCs, so the
# GKI image and modules built against it would no longer match.
CONFIG_ARM64_HW_AFDBM=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# MediaTek's timers and regulator coupler come as modules from this tree instead
# CONFIG_MTK_TIMER is not set
# CONFIG_MTK_CPUX_TIMER is not set
# CONFIG_MTK_REGULATOR_COUPLER is not set
# Name the kernel like GKI does (android15-8): VINTF reads the kernel FCM level from it
CONFIG_LOCALVERSION="-android15-8-4k"
# gold board drivers from gold's own tree (MiCode gold-s-oss)
CONFIG_HQ_NOTIFIER=m
CONFIG_SWITCH=m
CONFIG_HQ_SYSFS_SUPPORT=m
CONFIG_SIMTRAY_STATUS=m
CONFIG_XLOGCHAR=m
CONFIG_SND_SOC_AW87XXX=m
# gold's display: Xiaomi's ESD check (the panels' error flag line) and gold's three panels
CONFIG_MI_DISP_ESD_CHECK=y
CONFIG_DRM_PANEL_N17_36_02_0A_DSC_VDO=m
CONFIG_DRM_PANEL_N17_36_0F_0C_DSC_VDO=m
CONFIG_DRM_PANEL_N17_42_0D_0B_DSC_VDO=m
# gold's battery: its authentication chips (DS28E30, SLG, ST STICK)
CONFIG_ONEWIRE_GPIO=m
CONFIG_BATT_VERIFY_BY_DS28E30=m
CONFIG_BATT_VERIFY_BY_SLG=m
CONFIG_BATT_VERIFY_BY_ST=m
CONFIG_BATT_VERIFY=m
# Xiaomi's event reporting (/dev/miev), which stock's display, UFS, touch, audio
# and charging drivers report through
CONFIG_MIEV=m
# Xiaomi's memory info (/proc/mv, /sys/class/mi_memory), on top of ufs-mediatek-mod's
# Xiaomi context
CONFIG_MI_MEMORY_SYSFS=m
# Huaqin's kallsyms lookup, through which stock's audio machine drivers find the
# amplifier drivers' functions
CONFIG_HQ_KALLSYMS=m
# Xiaomi's /proc/cpumaxfreq, the CPU's top frequency in GHz
CONFIG_MI_CPU_MAX_FREQ=m

