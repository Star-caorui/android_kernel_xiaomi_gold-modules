	status = "okay";
};

&i2c3 {
	st21nfc: st21nfc@8 {
		compatible = "st,st21nfc";
		reg = <0x8>;
		interrupt-parent = <&pio>;
		interrupts = <5 0>;
		reset-gpios = <&pio 140 0>;
		irq-gpios = <&pio 5 0>;
		clkreq-gpios = <&pio 81 0>;
		status = "ok";
	};
	irq_nfc: irq_nfc {
		compatible = "mediatek,irq_nfc-eint";
		interrupt-parent = <&pio>;
		interrupts = <5 4>;
		status = "okay";
	};
};

#include "gold/cust.dtsi"

&i2c7 {
	sc8551x-charger@66 {
		compatible = "sc,sc8551x-standalone";
		reg = <0x66>;
		sc,sc8551x,irq-gpio = <&pio 18 0>;
		charger_name = "primary_dvchg";
		sc,sc8551x,vbat-ovp-dis = <0>;
		sc,sc8551x,vbat-ovp = <41>;
		sc,sc8551x,ibat-ocp-dis = <1>;
		sc,sc8551x,ibat-ocp = <61>;
		sc,sc8551x,vac-ovp = <1>;
		sc,sc8551x,vbus-ovp = <120>;
		sc,sc8551x,ibus-ocp-dis = <0>;
		sc,sc8551x,ibus-ocp = <13>;
		sc,sc8551x,fsw-set = <4>;
		sc,sc8551x,wd-timeout-dis = <1>;
		sc,sc8551x,wd-timeout = <3>;
		sc,sc8551x,ss-timeout = <7>;
		sc,sc8551x,vout-ovp-dis = <0>;
		sc,sc8551x,ibat-sns-r = <0>;
		sc,sc8551x,ibus-ucp-fall-dg = <1>;
		status = "okay";
	};
};

&i2c7 {
	ln8000_charger@51 {
		compatible = "cirrus,ln8000-main";
		reg = <0x51>;
		interrupt-parent = <&pio>;
		interrupts = <18 2 18 0>;
		cirrus,vbatovp-microvolt = <4550000>;
		cirrus,vbusovp-microvolt = <11000000>;
		cirrus,ibusocp-microamp = <4000000>;
		cirrus,vbatalarm-microvolt = <4450000>;
		cirrus,vbusalarm-microvolt = <10000000>;
		cirrus,dualsync-func = <0>;
		status = "okay";
	};
};
